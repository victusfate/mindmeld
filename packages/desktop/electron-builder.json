{
  "appId": "dev.mindmeld.studio",
  "productName": "Mind Meld Studio",
  "directories": { "output": "release" },
  "files": ["dist/**/*", "package.json"],
  "extraResources": [{ "from": "../web/dist", "to": "web", "filter": ["**/*"] }],
  "asar": true,
  "npmRebuild": false,
  "executableName": "mind-meld-studio",
  "linux": { "target": ["dir", "AppImage"], "category": "Development" },
  "mac": { "target": ["dmg"], "category": "public.app-category.developer-tools" },
  "win": { "target": ["nsis"] }
}
