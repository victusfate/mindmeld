{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["core/src/**/*.ts", "core/test/**/*.ts", "connectors/src/**/*.ts", "connectors/test/**/*.ts", "server/src/**/*.ts", "server/test/**/*.ts", "client/src/**/*.ts", "client/test/**/*.ts"]
}
