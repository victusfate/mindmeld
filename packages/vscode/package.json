{
  "name": "mindmeld-studio",
  "displayName": "Mind Meld Studio",
  "description": "See static (possible) and observed (recorded) call evidence from a Mind Meld Studio server inside VS Code.",
  "version": "0.1.0",
  "private": true,
  "publisher": "victusfate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/victusfate/mindmeld"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Mind Meld Studio",
      "properties": {
        "mindmeld.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Base URL of the Mind Meld Studio server. The access token is kept in VS Code secret storage, never in settings."
        }
      }
    },
    "commands": [
      {
        "command": "mindmeld.connect",
        "title": "Connect",
        "category": "Mind Meld"
      },
      {
        "command": "mindmeld.importWorkspace",
        "title": "Import Current Workspace",
        "category": "Mind Meld"
      },
      {
        "command": "mindmeld.refresh",
        "title": "Refresh Index",
        "category": "Mind Meld",
        "icon": "$(refresh)"
      },
      {
        "command": "mindmeld.allowlistAtCursor",
        "title": "Allowlist Function at Cursor",
        "category": "Mind Meld"
      },
      {
        "command": "mindmeld.runEntry",
        "title": "Run Entry",
        "category": "Mind Meld",
        "icon": "$(play)"
      },
      {
        "command": "mindmeld.ask",
        "title": "Ask Question",
        "category": "Mind Meld"
      },
      {
        "command": "mindmeld.showUsage",
        "title": "Show Usage",
        "category": "Mind Meld"
      },
      {
        "command": "mindmeld.exportUsage",
        "title": "Export Usage (JSONL)",
        "category": "Mind Meld"
      },
      {
        "command": "mindmeld.openStudio",
        "title": "Open Studio in Browser",
        "category": "Mind Meld"
      },
      {
        "command": "mindmeld.exportBundle",
        "title": "Export Bundle",
        "category": "Mind Meld"
      },
      {
        "command": "mindmeld.showCallers",
        "title": "Show Callers",
        "category": "Mind Meld"
      },
      {
        "command": "mindmeld.revealEvent",
        "title": "Reveal Event Source",
        "category": "Mind Meld"
      },
      {
        "command": "mindmeld.openSpan",
        "title": "Open Source Span",
        "category": "Mind Meld"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mindmeld.showCallers",
          "when": "false"
        },
        {
          "command": "mindmeld.revealEvent",
          "when": "false"
        },
        {
          "command": "mindmeld.openSpan",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "mindmeld.refresh",
          "when": "view == mindmeld.symbols",
          "group": "navigation"
        },
        {
          "command": "mindmeld.runEntry",
          "when": "view == mindmeld.runs",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mindmeld",
          "title": "Mind Meld",
          "icon": "media/mindmeld.svg"
        }
      ]
    },
    "views": {
      "mindmeld": [
        {
          "id": "mindmeld.symbols",
          "name": "Symbols"
        },
        {
          "id": "mindmeld.runs",
          "name": "Runs"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.ts",
    "test": "node --test --test-reporter=spec \"test/*.test.ts\"",
    "package": "node build.ts && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@mindmeld/client": "0.1.0",
    "@mindmeld/connectors": "0.1.0",
    "@mindmeld/core": "0.1.0",
    "@mindmeld/server": "0.1.0",
    "@types/vscode": "1.140.0",
    "esbuild": "0.28.2",
    "@vscode/vsce": "4.0.0"
  }
}
