{
  "name": "@mindmeld/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mind Meld Studio evidence core: safe import, TypeScript indexing, instrumentation, evidence store, citations.",
  "exports": {
    ".": "./src/index.ts",
    "./usage": "./src/usage.ts"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 --test-reporter=dot \"test/*.test.ts\""
  },
  "dependencies": {
    "typescript": "6.0.3"
  }
}
